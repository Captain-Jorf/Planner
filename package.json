{
  "name": "daily-planner",
  "version": "1.0.0",
  "description": "برنامه‌ریز روزانه فارسی با تاریخ شمسی — Persian daily planner (Vite + Capacitor)",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
