    "@capacitor/core": "^6.2.2",
    "@capacitor/local-notifications": "^6.1.3",
    "jalaali-js": "^2.0.1",
    "vazirmatn": "^33.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
    "vite": "^8.2.2"
  }
